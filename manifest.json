{
  "manifest_version": 2,
  "name": "Container User-Agent",
  "version": "1.0.0",
  "description": "Sends a Chrome User-Agent header in the containers you choose. Toggle from the toolbar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "container-user-agent@oskarkook",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "cookies",
    "contextualIdentities",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icons/off.svg",
    "default_title": "Container User-Agent: OFF in this container"
  },
  "options_ui": {
    "page": "options.html"
  }
}
